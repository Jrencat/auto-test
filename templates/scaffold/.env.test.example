# 自动化测试运行时配置示例（由 auto-test skill 脚手架生成）
# 复制为 tests/.env.test 并按本地/测试环境填写（tests/.env.test 不入库）
# 下方为通用示例值，按你的项目替换。

# 网关 / API 根地址
TEST_API_BASE=http://localhost:8080/api/

# 前端 dev server 地址
TEST_WEB_BASE=http://localhost:3000

# 前端 hash 路由 base（含 publicPath + #/）。
# 若前端 vite base 为 './'（未使用 publicPath），dev 实际以站点根路径提供服务，路由 base 应为 /#/。
# （路由 base 用错可能导致引导阶段相对路径资源 404 → 整站白屏）
TEST_WEB_ROUTE_BASE=/#/

# 前端 storage 前缀（用于注入 sessionStorage 登录态的 Cache 键）
TEST_APP_ID=APP_CACHE

# 密码加密密钥词（如前端有加密登录；明文登录可忽略）
TEST_PWD_ENC_KEY=changeme

# 测试账号（务必使用测试环境账号，切勿指向生产）
TEST_USERNAME=
TEST_PASSWORD=

# 请求头
TEST_LANG=zh_CN
TEST_PLAT=backend

# auto-test 默认测试页面文档目录（选项 B 扫描此目录下的 页面/接口/流程/需求.md；不写死，可改）
TEST_PAGE_DOC_DIR=docs/test-pages/

# auto-test 测试资产根目录（内含 cases/ 与 reports/）。
# 留空时 caseStore 从 tests/support 逐级向上自动查找已存在的 .auto-test 目录，通常无需填写。
# 需要指向仓库外或多仓共享时才填绝对路径。
AUTO_TEST_DIR=
